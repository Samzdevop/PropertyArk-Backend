{
  "name": "photo-api",
  "version": "1.0.0",
  "description": "a photo processing, storage and printing platform",
  "main": "index.js",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/socket.io": "^3.0.2",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@prisma/client": "^6.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "bull-board": "^2.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-redis": "^6.1.1",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "scripts": {
    "migration:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "test": "dotenv -e .env.test -- jest --verbose --detectOpenHandles --runInBand --forceExit",
    "dev": "ts-node-dev src/index.ts",
    "update:companies": "ts-node ./src/scripts/updateUserCompanyNames.ts",
    "start": "node build/index.js",
    "render-build": "yarn prisma generate && yarn prisma migrate deploy",
    "lint": "eslint --ext .ts .",
    "test:process": "yarn migration:test && yarn lint && yarn test",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "db:reset": "yarn prisma:reset && yarn prisma:seed",
    "db:refresh": "yarn prisma:migrate && yarn prisma:seed"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  },
