  "scripts": {
    "migration:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "test": "dotenv -e .env.test -- jest --verbose --detectOpenHandles --runInBand --forceExit",
    "dev": "ts-node-dev src/index.ts",
    "update:companies": "ts-node ./src/scripts/updateUserCompanyNames.ts",
    "start": "node build/index.js",
    "render-build": "yarn prisma generate && yarn prisma migrate deploy",
    "lint": "eslint --ext .ts .",
    "test:process": "yarn migration:test && yarn lint && yarn test",
    "build": "tsc && copyfiles -u 1 \"src/views/**/*\" build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "db:reset": "yarn prisma:reset && yarn prisma:seed",
    "db:refresh": "yarn prisma:migrate && yarn prisma:seed"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  },
