// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  ADMIN
  VENDOR
  USER
  STAFF
}

enum ListingType {
  FOR_RENT
  FOR_SALE
  FOR_LAND
  FOR_SHORTLET
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  UNDER_MAINTENANCE
  UNDER_CONSTRUCTION
  SOLD
  RENTED
}

enum PropertyListingStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
  MIXED_USE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum DocumentType {
  NIN
  IDENTIFICATION
  PROOF_OF_INCOME
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  NIN_VERIFIED
  NIN_REJECTED
  PAYMENT_CONFIRMATION
  GENERAL
}

// ============ MODELS ============

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String?
  fullName            String
  phone               String?
  avatar              String?
  location            String?
  role                Role      @default(USER)
  isVerified          Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  isDeleted           Boolean   @default(false)
  lastLogin           DateTime?
  verificationCode    String?
  verificationExpires DateTime?

  // NIN Verification
  ninPhotoUrl           String?
  ninVerificationStatus VerificationStatus @default(PENDING)
  ninVerifiedAt         DateTime?
  ninVerifiedBy         String?
  ninRejectionReason    String?

  // Staff specific fields
  employeeId String? @unique
  department String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties      Property[]     @relation("PropertyVendor")
  staffProperties Property[]     @relation("PropertyStaff")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  documents       Document[]     @relation("UploadedBy")
  vendorNIN       Document[]     @relation("VendorNIN")

  // Password reset
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  @@index([email])
  @@index([role])
  @@index([isVerified])
  @@index([isSuspended])
  @@index([ninVerificationStatus])
  @@index([employeeId])
}

model Property {
  id            String                @id @default(cuid())
  name          String
  description   String?
  type          PropertyType
  listingType   ListingType
  status        PropertyStatus        @default(AVAILABLE)
  listingStatus PropertyListingStatus @default(PENDING)

  // Pricing based on listing type
  rentAmount     Float? // FOR_RENT
  salePrice      Float? // FOR_SALE
  landFee        Float? // FOR_LAND
  shortletAmount Float? // FOR_SHORTLET

  address String
  city    String
  state   String
  country String
  zipCode String

  size      Float?
  sizeUnit  String? @default("sqft")
  bedrooms  Int?
  bathrooms Float?
  yearBuilt Int?
  amenities Json?

  // Relations
  vendorId String
  vendor   User   @relation("PropertyVendor", fields: [vendorId], references: [id])

  staffId String?
  staff   User?   @relation("PropertyStaff", fields: [staffId], references: [id])

  documents Document[]
  media     Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin who approved/rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([vendorId])
  @@index([staffId])
  @@index([status])
  @@index([listingType])
  @@index([listingStatus])
  @@index([city, state])
}

model Media {
  id        String    @id @default(cuid())
  name      String
  type      MediaType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?
  isPrimary Boolean   @default(false)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  // For NIN documents
  vendorId String?
  vendor   User?   @relation("VendorNIN", fields: [vendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([uploadedById])
  @@index([vendorId])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  message String
  data    Json?
  read    Boolean          @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model ActivityLog {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  description String?
  details     Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([action])
}

model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue Json
  description String?
  isActive    Boolean  @default(true)
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
