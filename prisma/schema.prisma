// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  ADMIN
  VENDOR
  USER
  STAFF
}

enum ListingType {
  FOR_RENT
  FOR_SALE
  FOR_LAND
  FOR_SHORTLET
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  UNDER_MAINTENANCE
  UNDER_CONSTRUCTION
  SOLD
  RENTED
}

enum PropertyListingStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
  MIXED_USE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum DocumentType {
  NIN
  IDENTIFICATION
  PROOF_OF_INCOME
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  NIN_VERIFIED
  NIN_REJECTED
  PAYMENT_CONFIRMATION
  GENERAL
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MeetingType {
  VIDEO_CALL
  IN_PERSON
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  password              String?
  fullName              String
  googleId              String?            @unique
  phone                 String?
  avatar                String?
  location              String?
  role                  Role               @default(USER)
  isVerified            Boolean            @default(false)
  isSuspended           Boolean            @default(false)
  isDeleted             Boolean            @default(false)
  lastLogin             DateTime?
  verificationCode      String?
  verificationExpires   DateTime?
  ninPhotoUrl           String?
  ninVerificationStatus VerificationStatus @default(PENDING)
  ninVerifiedAt         DateTime?
  ninVerifiedBy         String?
  ninRejectionReason    String?
  propertyViews         PropertyView[]
  favorites             Favorite[]
  inquiries             Inquiry[]          @relation("UserInquiries")
  vendorInquiries       Inquiry[]          @relation("VendorInquiries")
  employeeId            String?            @unique
  department            String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  properties      Property[]     @relation("PropertyVendor")
  staffProperties Property[]     @relation("PropertyStaff")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  documents       Document[]     @relation("UploadedBy")
  vendorNIN       Document[]     @relation("VendorNIN")

  // Password reset
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  @@index([email])
  @@index([role])
  @@index([isVerified])
  @@index([isSuspended])
  @@index([ninVerificationStatus])
  @@index([employeeId])
}

model Property {
  id             String                @id @default(cuid())
  name           String
  description    String?
  type           PropertyType
  listingType    ListingType
  status         PropertyStatus        @default(AVAILABLE)
  listingStatus  PropertyListingStatus @default(PENDING)
  rentAmount     Float?
  salePrice      Float?
  landFee        Float?
  shortletAmount Float?

  address   String
  city      String
  state     String
  country   String
  zipCode   String
  size      Float?
  sizeUnit  String? @default("sqft")
  bedrooms  Int?
  bathrooms Float?
  yearBuilt Int?
  amenities Json?
  vendorId  String
  vendor    User    @relation("PropertyVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  staffId      String?
  staff        User?          @relation("PropertyStaff", fields: [staffId], references: [id])
  views        PropertyView[]
  viewCount    Int            @default(0)
  inquiryCount Int            @default(0)
  favorites    Favorite[]
  inquiries    Inquiry[]

  documents Document[]
  media     Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin who approved/rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([vendorId])
  @@index([staffId])
  @@index([status])
  @@index([listingType])
  @@index([listingStatus])
  @@index([city, state])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewerId   String?
  viewer     User?    @relation(fields: [viewerId], references: [id])
  ipAddress  String?
  userAgent  String?
  referrer   String?
  sessionId  String?
  viewedAt   DateTime @default(now())

  @@index([propertyId])
  @@index([viewedAt])
  @@index([viewerId])
  @@index([sessionId])
}

model Media {
  id        String    @id @default(cuid())
  name      String
  type      MediaType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?
  isPrimary Boolean   @default(false)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  // For NIN documents
  vendorId String?
  vendor   User?   @relation("VendorNIN", fields: [vendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([uploadedById])
  @@index([vendorId])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  message String
  data    Json?
  read    Boolean          @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model ActivityLog {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  description String?
  details     Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([action])
}

model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue Json
  description String?
  isActive    Boolean  @default(true)
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Inquiry {
  id            String   @id @default(cuid())
  inquiryNumber String   @unique
  userId        String
  user          User     @relation("UserInquiries", fields: [userId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  vendorId      String
  vendor        User     @relation("VendorInquiries", fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  location    String
  message     String
  meetingType MeetingType

  status       InquiryStatus @default(PENDING)
  responseNote String? // Used for decline reason

  viewedAt    DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}
