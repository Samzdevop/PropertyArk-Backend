// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
  USER
  STAFF
}

enum ListingType {
  FOR_RENT
  FOR_SALE
  FOR_LAND
  FOR_SHORTLET
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  UNDER_MAINTENANCE
  UNDER_CONSTRUCTION
  SOLD
  RENTED
}

enum PropertyListingStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  LAND
  MIXED_USE
}

enum BookingStatus {
  PENDING
  APPROVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum DocumentType {
  NIN
  IDENTIFICATION
  PROOF_OF_INCOME
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  NIN_VERIFIED
  NIN_REJECTED
  PAYMENT_CONFIRMATION
  GENERAL
}

enum SatisfactionStatus {
  SATISFIED
  NOT_SATISFIED
  OTHERS
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MeetingType {
  VIDEO_CALL
  IN_PERSON
}

enum NotificationChannel {
  IN_APP
  EMAIL
  BOTH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  password              String?
  fullName              String
  googleId              String?            @unique
  phone                 String?
  avatar                String?
  location              String?
  role                  Role               @default(USER)
  isVerified            Boolean            @default(false)
  isSuspended           Boolean            @default(false)
  isDeleted             Boolean            @default(false)
  lastLogin             DateTime?
  verificationCode      String?
  verificationExpires   DateTime?
  ninPhotoUrl           String?
  ninVerificationStatus VerificationStatus @default(PENDING)
  ninVerifiedAt         DateTime?
  ninVerifiedBy         String?
  ninRejectionReason    String?
  propertyViews         PropertyView[]
  favorites             Favorite[]
  inquiries             Inquiry[]          @relation("UserInquiries")
  vendorInquiries       Inquiry[]          @relation("VendorInquiries")
  employeeId            String?            @unique
  department            String?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  properties             Property[]        @relation("PropertyVendor")
  staffProperties        Property[]        @relation("PropertyStaff")
  notifications          Notification[]
  activityLogs           ActivityLog[]
  documents              Document[]        @relation("UploadedBy")
  vendorNIN              Document[]        @relation("VendorNIN")
  vendorShortletBookings ShortletBooking[] @relation("VendorShortletBookings")
  userShortletBookings   ShortletBooking[] @relation("UserShortletBookings")

  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  vendorAvailabilities   VendorAvailability[]

  @@index([email])
  @@index([role])
  @@index([isVerified])
  @@index([isSuspended])
  @@index([ninVerificationStatus])
  @@index([employeeId])
}

model Property {
  id             String                @id @default(cuid())
  name           String
  description    String?
  type           PropertyType
  listingType    ListingType
  status         PropertyStatus        @default(AVAILABLE)
  listingStatus  PropertyListingStatus @default(PENDING)
  rentAmount     Float?
  salePrice      Float?
  landFee        Float?
  shortletAmount Float?

  address   String
  city      String
  state     String
  country   String
  zipCode   String
  size      Float?
  sizeUnit  String? @default("sqft")
  bedrooms  Int?
  bathrooms Float?
  yearBuilt Int?
  amenities Json?
  vendorId  String
  vendor    User    @relation("PropertyVendor", fields: [vendorId], references: [id], onDelete: Cascade)

  staffId      String?
  staff        User?          @relation("PropertyStaff", fields: [staffId], references: [id])
  views        PropertyView[]
  viewCount    Int            @default(0)
  inquiryCount Int            @default(0)
  favorites    Favorite[]
  inquiries    Inquiry[]

  documents        Document[]
  media            Media[]
  shortletBookings ShortletBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin who approved/rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([vendorId])
  @@index([staffId])
  @@index([status])
  @@index([listingType])
  @@index([listingStatus])
  @@index([city, state])
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewerId   String?
  viewer     User?    @relation(fields: [viewerId], references: [id])
  ipAddress  String?
  userAgent  String?
  referrer   String?
  sessionId  String?
  viewedAt   DateTime @default(now())

  @@index([propertyId])
  @@index([viewedAt])
  @@index([viewerId])
  @@index([sessionId])
}

model Media {
  id        String    @id @default(cuid())
  name      String
  type      MediaType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?
  isPrimary Boolean   @default(false)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  url       String
  key       String
  size      Int
  mimeType  String
  container String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  // For NIN documents
  vendorId String?
  vendor   User?   @relation("VendorNIN", fields: [vendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([uploadedById])
  @@index([vendorId])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  message String
  data    Json?
  read    Boolean          @default(false)
  readAt  DateTime?

  channel     NotificationChannel  @default(IN_APP)
  priority    NotificationPriority @default(NORMAL)
  sentAt      DateTime?
  deliveredAt DateTime?
  bulkId      String?
  isBulk      Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([bulkId])
  @@index([channel])
  @@index([priority])
}

model BulkNotification {
  id             String               @id @default(cuid())
  bulkId         String               @unique
  title          String
  message        String
  channel        NotificationChannel
  priority       NotificationPriority
  targetAudience String
  targetUserIds  String[]
  targetRoles    String[]

  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  failedCount    Int @default(0)

  sentBy String // Admin ID who sent it
  sentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bulkId])
  @@index([sentAt])
  @@index([targetAudience])
}

model ActivityLog {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  description String?
  details     Json?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([action])
}

model VendorAvailability {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  date        DateTime
  startTime   String
  endTime     String
  isActive    Boolean  @default(true)
  isRecurring Boolean  @default(false)
  dayOfWeek   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, date, startTime, endTime])
  @@index([vendorId])
  @@index([date])
  @@index([isActive])
}

model ShortletBooking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id])
  vendorId       String
  vendor         User          @relation("VendorShortletBookings", fields: [vendorId], references: [id])
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String?
  adultCount     Int           @default(1)
  childCount     Int           @default(0)
  checkInDate    DateTime
  checkOutDate   DateTime
  totalNights    Int
  paymentMethod  PaymentMethod
  totalAmount    Float
  currency       String        @default("NGN")
  status         BookingStatus @default(PENDING)
  userId         String?
  user           User?         @relation("UserShortletBookings", fields: [userId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  cancelledAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?

  @@index([propertyId])
  @@index([vendorId])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([guestEmail])
}

model PlatformSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue Json
  description String?
  isActive    Boolean  @default(true)
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Inquiry {
  id            String   @id @default(cuid())
  inquiryNumber String   @unique
  userId        String
  user          User     @relation("UserInquiries", fields: [userId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  vendorId      String
  vendor        User     @relation("VendorInquiries", fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  location    String
  message     String
  meetingType MeetingType

  satisfactionStatus  SatisfactionStatus?
  satisfactionComment String?

  proposedDate  DateTime?
  scheduledDate DateTime?

  status       InquiryStatus @default(PENDING)
  isCompleted  Boolean       @default(false)
  completedAt  DateTime?
  responseNote String?

  viewedAt    DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}
