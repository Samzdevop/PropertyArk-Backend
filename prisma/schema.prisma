// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  location    String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note []

  
  // Relations
  users       User[]
  appointments Appointment[]
  farmVisits  FarmVisit[]
  livestock   Livestock[]
  tasks       Task[]
  
  @@map("companies")
}


model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  phone               String?   @unique
  googleId            String?   @unique
  companyName         String?
  company             Company?  @relation(fields: [companyId], references: [id])
  companyId           String? 
  password            String?
  fullName            String
  avatar              String?
  location            String?
  role                Role      @default(ADMIN)
  lastLogin           DateTime?
  verificationCode    String?
  verificationExpires DateTime?
  isVerified          Boolean   @default(false)
  isSuspended         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  assignedTasks        Task[]                 @relation("TaskAssignedTo")
  createdTasks         Task[]                 @relation("CreatedTasks")
  livestockAdded       Livestock[]            @relation("LivestockAddedBy")
  livestockUpdated     Livestock[]            @relation("LivestockUpdatedBy")
  deletedLivestock     Livestock[]            @relation("LivestockDeletedBy")
  vaccination          Vaccination[]
  Sickness             Sickness[]
  Treatment            Treatment[]
  OfftakeRecord        OfftakeRecord[]
  TaskObservation      TaskObservation[]      @relation("UserTaskObservations")
  InventoryRecord      InventoryRecord[]
  FinancialTransaction FinancialTransaction[]
  Diagnosis            Diagnosis[]
  prescribedTreatments PrescribedTreatment[]
  followUps            FollowUp[]
  notifications        Notification[]
  appointments         Appointment[]  
  farmVisits           FarmVisit[]    
  notes                Note[] 
  notificationSettings NotificationSettings?
  conversations        ConversationParticipant[]
  sentMessages         Message[]                

  // Creator relationship
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id])
  createdById  String?
  createdUsers User[]  @relation("UserCreator")

  @@index([companyId])

}

model Livestock {
  id               String       @id @default(cuid())
  tagId            String       @unique
  type             String
  breed            String?
  birthDate        DateTime?
  company             Company?  @relation(fields: [companyId], references: [id])
  companyId           String?
  healthStatus     HealthStatus
  weight           Float?
  gender           String
  livestockSource  String?
  livestockPurpose String?
  isSick           Boolean      @default(false)
  isTreatment      Boolean      @default(false)

  isDeleted        Boolean   @default(false)
  deletionReason   String?
  deletedAt        DateTime?
  deletedBy        User?     @relation("LivestockDeletedBy", fields: [deletedById], references: [id]) // New relation
  deletedById      String?

  sickness           Sickness[]
  treatments         Treatment[]
  addedBy            User            @relation("LivestockAddedBy", fields: [addedById], references: [id])
  addedById          String
  updatedBy          User?           @relation("LivestockUpdatedBy", fields: [updatedById], references: [id])
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  vaccinationRecords Vaccination[]
  OfftakeRecord      OfftakeRecord[]
  tasks              Task[]   
  diagnoses          Diagnosis[]  
  prescribedTreatments PrescribedTreatment[]
  followUps          FollowUp[]     

  @@index([companyId])

}

model Vaccination {
  id                String    @id @default(cuid())
  livestock         Livestock @relation(fields: [livestockId], references: [id])
  livestockId       String
  dateofVaccination DateTime
  vaccineType       String
  dosage            Float
  administeredBy    String
  nextDueDate       DateTime?
  recordedBy        User      @relation(fields: [recordedById], references: [id])
  recordedById      String
  createdAt         DateTime  @default(now())
}

model Sickness {
  id                String      @id @default(cuid())
  livestock         Livestock   @relation(fields: [livestockId], references: [id])
  livestockId       String
  dateOfObservation DateTime
  observedSymptoms  String
  suspectedCause    String?
  notes             String?
  recordedBy        User        @relation(fields: [recordedById], references: [id])
  recordedById      String
  createdAt         DateTime    @default(now())
  treatments        Treatment[]
}

model Treatment {
  id              String    @id @default(cuid())
  sickness        Sickness? @relation(fields: [sicknessId], references: [id])
  sicknessId      String?
  livestock       Livestock @relation(fields: [livestockId], references: [id])
  livestockId     String
  dateOfTreatment DateTime
  treatmentType   String
  dosage          Float
  cause           String
  administeredBy  String
  nextDueDate     DateTime?
  recordedBy      User      @relation(fields: [recordedById], references: [id])
  recordedById    String
  createdAt       DateTime  @default(now())
}

model OfftakeRecord {
  id           String    @id @default(cuid())
  livestock    Livestock @relation(fields: [livestockId], references: [id])
  livestockId  String
  type         Offtake
  dateOfEvent  DateTime
  destination  String?
  price        Float?
  causeOfDeath String?
  notes        String?
  recordedBy   User      @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt    DateTime  @default(now())

  @@index([livestockId])
  @@index([type])
}

model Task {
  id           String            @id @default(cuid())
  name         String
  description  String
  priority     Priority
  company             Company?  @relation(fields: [companyId], references: [id])
  companyId           String?
  dueDate      DateTime
  status       TaskStatus        @default(PENDING)
  observations TaskObservation[]
  assignedTo   User              @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String
  assignedBy   User              @relation("CreatedTasks", fields: [assignedById], references: [id])
  assignedById String

  livestock   Livestock? @relation(fields: [livestockId], references: [id])
  livestockId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([assignedToId])
  @@index([livestockId])
}

model TaskObservation {
  id           String   @id @default(cuid())
  note         String
  mediaUrls    String[]
  reportedAt   DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id])
  taskId       String
  reportedBy   User     @relation("UserTaskObservations", fields: [reportedById], references: [id])
  reportedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId])
  @@index([reportedById])
}

model Inventory {
  id              String            @id @default(cuid())
  type            InventoryType
  name            String
  currentQuantity Float
  unit            String            @default("units")
  purchasePrice   Float?
  reorderPoint    Float
  supplier        String?
  notes           String?
  mediaUrls       String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  records         InventoryRecord[]
}

model InventoryRecord {
  id             String              @id @default(cuid())
  recordType     InventoryRecordType
  quantity       Float
  pricePerUnit   Float?
  totalCost      Float?
  date           DateTime
  movementType   String?
  relatedAnimals String?
  notes          String?
  mediaUrls      String[]
  inventory      Inventory?          @relation(fields: [inventoryId], references: [id])
  inventoryId    String?
  recordedBy     User                @relation(fields: [recordedById], references: [id])
  recordedById   String
  createdAt      DateTime            @default(now())
}

model FinancialTransaction {
  id              String                   @id @default(cuid())
  type            FinancialTransactionType
  referenceNumber String
  title           String
  amount          Float
  paymentMethod   String
  date            DateTime
  description     String?
  partyName       String // Buyer or vendor name
  mediaUrls       String[]
  recordedBy      User                     @relation(fields: [recordedById], references: [id])
  recordedById    String
  createdAt       DateTime                 @default(now())

  @@index([type])
  @@index([date])
}

model Diagnosis {
  id              String           @id @default(cuid())
  livestock       Livestock        @relation(fields: [livestockId], references: [id])
  livestockId     String
  diagnosis       String
  labTests        String?
  severity        DiagnosisSeverity @default(MILD)
  prognosis       DiagnosisPrognosis @default(GOOD)
  observations    String?
  date            DateTime
  recordedBy      User             @relation(fields: [recordedById], references: [id])
  recordedById    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([livestockId])
  @@index([date])
  @@index([severity])
  @@index([prognosis])
}

model PrescribedTreatment {
  id              String               @id @default(cuid())
  livestock       Livestock            @relation(fields: [livestockId], references: [id])
  livestockId     String
  treatmentType   String
  medicationName  String 
  dosage          String
  frequency       Frequency
  routine         AdministrationRoutine
  additionalNotes String?
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean              @default(true)
  recordedBy      User                 @relation(fields: [recordedById], references: [id])
  recordedById    String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  followUps       FollowUp[]
  reminders       TreatmentReminder[]

  @@index([livestockId])
  @@index([isActive])
  @@index([startDate])
}

model FollowUp {
  id                String        @id @default(cuid())
  prescribedTreatment PrescribedTreatment? @relation(fields: [prescribedTreatmentId], references: [id])
  prescribedTreatmentId String?
  reason            String
  date              DateTime
  time              DateTime
  relatedAnimal     Livestock     @relation(fields: [relatedAnimalId], references: [id])
  relatedAnimalId   String
  relatedFarm       String
  location          String
  additionalNotes   String?
  setReminder       Boolean       @default(false)
  notifyFarmStaff   Boolean       @default(false)
  status            String        @default("SCHEDULED") 
  recordedBy        User          @relation(fields: [recordedById], references: [id])
  recordedById      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reminders         FollowUpReminder[]

  @@index([date])
  @@index([relatedAnimalId])
  @@index([status])
}

model TreatmentReminder {
  id                    String              @id @default(cuid())
  prescribedTreatment   PrescribedTreatment @relation(fields: [prescribedTreatmentId], references: [id])
  prescribedTreatmentId String
  reminderType          String // "DAILY", "WEEKLY", etc.
  dueDate               DateTime
  isSent                Boolean             @default(false)
  sentAt                DateTime?
  createdAt             DateTime            @default(now())
}

model FollowUpReminder {
  id            String   @id @default(cuid())
  followUp      FollowUp @relation(fields: [followUpId], references: [id])
  followUpId    String
  reminderType  String   // "1_DAY_BEFORE", "1_HOUR_BEFORE"
  dueDate       DateTime
  isSent        Boolean  @default(false)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
}

model Notification {
  id          String             @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  recipient   User               @relation(fields: [recipientId], references: [id])
  recipientId String
  relatedEntityType String?      // e.g., "TASK", "FOLLOW_UP", "TREATMENT"
  relatedEntityId   String?
  metadata    Json?
  sentAt      DateTime           @default(now())
  readAt      DateTime?
  createdAt   DateTime           @default(now())

  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([sentAt])
}

model Appointment {
  id              String        @id @default(cuid())
  visitType       VisitType
  title           String
  date            DateTime
  time            DateTime
  company             Company?  @relation(fields: [companyId], references: [id])
  companyId           String?
  relatedFarm     String
  relatedAnimal   String?
  purpose         String
  setReminder     Boolean       @default(false)
  notifyFarmStaff Boolean       @default(false)
  status          String        @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  recordedBy      User          @relation(fields: [recordedById], references: [id])
  recordedById    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reminders       AppointmentReminder[]
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@index([recordedById])
}

model AppointmentReminder {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String
  reminderType  String     
  dueDate       DateTime
  isSent        Boolean     @default(false)
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
}

model FarmVisit {
  id                String   @id @default(cuid())
  company           Company?  @relation(fields: [companyId], references: [id])
  companyId         String?
  relatedFarm       String
  date              DateTime
  time              DateTime
  reason            String
  keyPersonnelMet   String
  animalExamined    String
  farmObservation   String
  farmRecommendation String
  mediaUrls         String[] // Store image URLs instead of files
  recordedBy        User     @relation(fields: [recordedById], references: [id])
  recordedById      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([date])
  @@index([recordedById])
}

model Note {
  id          String   @id @default(cuid())
  folderName  String
  date        DateTime
  title       String
  body        String
  company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?
  recordedBy  User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notes")
  @@index([companyId])
  @@index([folderName])
  @@index([date])
}

model NotificationSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification toggles
  followUpReminders     Boolean  @default(true)
  upcomingAppointments  Boolean  @default(true)
  messageNotifications  Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("notification_settings")
}


model Conversation {
  id        String   @id @default(cuid())
  title     String?
  type      ConversationType @default(DIRECT)
  participants ConversationParticipant[]
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  joinedAt       DateTime @default(now())
  
  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User     @relation(fields: [senderId], references: [id])
  senderId       String
  content        String
  messageType    MessageType @default(TEXT)
  mediaUrl       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("messages")
  @@index([conversationId])
  @@index([senderId])
}


enum HealthStatus {
  HEALTHY
  SICK
  IN_TREATMENT
  RECOVERING
  CRITICAL
}

enum Offtake {
  SALE
  DEATH
  MISSING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum Role {
  ADMIN
  FARM_KEEPER
  COWORKER
  VET
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum InventoryType {
  FEED
  MEDICINE
  EQUIPMENT
}

enum InventoryRecordType {
  NEW
  ITEM
  USE
}

enum DiagnosisSeverity {
  MILD
  MODERATE 
  SEVERE
  CRITICAL
  CHRONIC
}

enum DiagnosisPrognosis {
  GOOD
  FAIR
  GUARDED
  POOR
}

enum Frequency {
  DAILY
  TWICE_DAILY
  EVERY_OTHER_DAY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  AS_NEEDED
}

enum AdministrationRoutine {
  ORAL
  INTRAMUSCULAR
  SUBCUTANEOUS
  INTRAVENOUS
  TOPICAL
  INTRAMAMMARY
}

enum NotificationType {
  TASK_ASSIGNED
  FOLLOW_UP_REMINDER
  TREATMENT_REMINDER
  ANNOUNCEMENT
  SYSTEM_ALERT
  APPOINTMENT_REMINDER
  MESSAGE
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}


enum VisitType {
  FARM_VISIT
  MEETING
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}