<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background-color: #1C96C1; color: white; padding: 20px; text-align: center; border-radius: 5px 5px 0 0; }
    .content { background-color: #f9f9f9; padding: 30px; border-radius: 0 0 5px 5px; border: 1px solid #ddd; border-top: none; }
    .info-box { background-color: #e3f2fd; padding: 15px; margin: 20px 0; border-radius: 5px; }
    .button { display: inline-block; background-color: #1C96C1; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; margin: 20px 0; }
    .footer { margin-top: 30px; text-align: center; font-size: 12px; color: #666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>New Contact Message</h2>
    </div>
    <div class="content">
      <p>A new contact message has been submitted.</p>

      <div class="info-box">
        <strong>From:</strong><br>
        {{fullName}} ({{email}})
      </div>

      <div class="info-box">
        <strong>Subject:</strong> {{subject}}
      </div>

      <div class="info-box">
        <strong>Message:</strong><br>
        {{message}}
      </div>

      <p><small>Submitted: {{submittedAt}} | Contact #: {{contactNumber}}</small></p>

      <div style="text-align: center;">
        <a href="{{dashboardUrl}}" class="button">View in Dashboard</a>
      </div>
    </div>
    <div class="footer">
      <p>© {{currentYear}} PropertyArk. All rights reserved.</p>
    </div>
  </div>
</body>
</html>